		section.section#blog
			.container
				.blog
					.blog__head.section__head
						.section__title 
							.section__title-text Пишем о разном
						h2.section__subtitle Блог
					.blog__list
						each text in blogList 
							.blog__item 
								+blog-card(text)
		section.section.section--green#news
			.container
				.news
					.news__head.section__head
						.section__title 
							.section__title-text Из жизни агропарка
						h2.section__subtitle Новости
					ul.news__list
						each news in newsList 
							li.news__item 
								+news-card(news)