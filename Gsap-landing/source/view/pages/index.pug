		section.section#about
			.container
				.workers
					.workers__head.section__head
						.section__title 
							h2.section__title-text наши фермеры
						.section__subtitle У каждого вкуса своя история
					ul.workers__list
						each worker in workers 
							li.workers__item 
								+worker-card(worker)
		section.section.section--green#process
			h2.visually-hidden Процессы
			.container
				.process
					.process__head.section__head
						.section__title 
							.section__title-text Как продукт попадает на прилавок
					.process__content 
						.process__slider.process-slider
							.process-slider__slider.swiper
