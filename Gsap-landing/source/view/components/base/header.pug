mixin header(headerMods, currentUrl)
	-
		const headerLinks = [
			{
				href: "index.html",
				text: "Главная"
			},
			{
				href: "#",
				text: "Страница 2"
			},
			{
				href: "#",
				text: "Страница 3"
			},
		]
	- const menuHoverId = `menu-hover-header-1`;

	header.header(class=headerMods)&attributes(attributes)
		.container.header__container
			.header__logo.logo
				img.logo__img(src="./img/icons/logo.svg" width="124" height="100" alt="Агропарк")
			nav.nav.header__nav(aria-label="Главная навигация")
				button.nav__burger.burger(type="button" aria-expanded="false" aria-controls="menu" aria-label="Открыть меню")
					span.burger__line(aria-hidden="true")
					span.burger__line(aria-hidden="true")
					span.burger__line(aria-hidden="true")
					span.burger__line(aria-hidden="true")
				.nav__menu#menu
					ul.nav__list 
						each item in headerNav
							li.nav__item 
								a(href=item.href).nav__link!= item.title
									svg.nav__link-decor(width="100%" height="100%" viewBox="0 0 200 80" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false")
										ellipse(cx="100" cy="40" rx="95" ry="35")
