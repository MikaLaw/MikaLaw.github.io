{
  "name": "my-pug-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.11"
  },
  "scripts": {
    "editorconfig": "editorconfig-cli",
    "start": "cross-env NODE_ENV=development gulp start",
    "build": "cross-env NODE_ENV=production gulp build"
  },
  "browserslist": [
    "last 4 versions",
    "not dead",
    "not op_mini all",
    "not and_uc > 0",
    "not < 0.2%"
  ],
  "editorconfig-cli": [
    "*.json",
    "*.js",
    "source/**/*.html",
    "source/**/*.pug",
    "source/js/**/*.js",
    "source/img/**/*.svg",
    "source/sass/**/*.{sass,scss}"
  ],
  "devDependencies": {
    "@htmlacademy/editorconfig-cli": "3.0.0",
    "browser-sync": "^3.0.4",
    "browserslist-to-esbuild": "2.1.1",
    "cross-env": "10.1.0",
    "del": "8.0.1",
    "eslint": "7.32.0",
    "gulp": "5.0.1",
    "gulp-cheerio": "1.0.0",
    "gulp-esbuild": "0.14.1",
    "gulp-if": "3.0.0",
    "gulp-imagemin": "9.2.0",
    "gulp-plumber": "1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-pug": "5.0.0",
    "gulp-rename": "2.1.0",
    "gulp-sass": "6.0.1",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-stacksvg": "5.0.1",
    "gulp-svgmin": "4.1.0",
    "gulp-webp": "5.1.0",
    "imagemin-mozjpeg": "10.0.0",
    "imagemin-pngquant": "10.0.0",
    "merge-stream": "^2.0.0",
    "postcss-lightningcss": "1.0.2",
    "postcss-scss": "4.0.9",
    "postcss-sort-media-queries": "^6.7.1",
    "sass": "1.79.6",
    "stylelint": "14.16.1",
    "stylelint-config-rational-order": "0.1.2",
    "stylelint-config-standard-scss": "3.0.0",
    "stylelint-scss": "5.3.2"
  }
}
