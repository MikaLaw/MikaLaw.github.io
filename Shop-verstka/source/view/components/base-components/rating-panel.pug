mixin rating-panel(options = {})
  -
    const {
      id = `rp-${Math.random().toString(36).substr(2, 9)}`,
      active = 3,
      text = '10 отзывов',
      mode = 'full',
      colorActive = '#1551e5',
      colorBg = '#e3e3e3',
    } = options;

  .rating-panel&attributes(attributes)
    .rating-panel__wrap
      if mode === "full"
        .rating-panel__icons(role="img" aria-label="Рейтинг: " + active + " из 5")
          - for (let i = 1; i <= 5; i++)
            .rating-panel__icon(class=  i === active ? 'is-checked' : null aria-hidden="true")
      if mode === "percent"
        .rating-panel__icons(role="img" aria-label="Рейтинг: " + active + " из 5")
          - const percent = (active / 5) * 100 // Исправлен расчет процентов
          svg.sm-rating.stars(width="80" height="16" xmlns="http://www.w3.org/2000/svg")
            defs
              path(id=`s-${id}` d="M8 12.24l-4.11 1.92.56-4.5-3.1-3.32 4.45-.86L8 1.5l2.2 3.98 4.46.86-3.1 3.31.55 4.51z")
            pattern(id=`p-${id}` width="0.2" height="1")
              use(href=`#s-${id}` height="16" width="16" fill="#fff")
            linearGradient(id=`g-${id}`)
              stop(stop-color=colorActive offset=percent + '%')
              stop(stop-color=colorBg offset=percent + '%')
            mask(id=`m-${id}`)
              rect(fill=`url(#p-${id})` width="100%" height="100%")
            rect(fill=`url(#g-${id})` mask=`url(#m-${id})` width="100%" height="100%")
      if mode === "interactive"
        fieldset.rating-panel__icons
          legend.visually-hidden!= `Поставить оценку товару`
          - for (let i = 1; i <= 5; i++) 
            label.rating-panel__icon
              input.visually-hidden(
                type='radio' 
                name=`rating-${id}` 
                value=i 
                checked=i === Math.round(active)
                aria-label= `${i} балл`,
              )
      if text
        .rating-panel__text= text