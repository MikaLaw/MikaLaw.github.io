mixin text-cut(options={})
  -
    const {
      id = `text-cut-${Math.random().toString(36).substr(2, 9)}`, 
      text = [
        'Идейные соображения высшего порядка, а также постоянный количественный рост и сфера нашей активности представляет собой интересный эксперимент проверки дальнейших направлений развития. Не следует, однако забывать, что сложившаяся структура организации обеспечивает широкому кругу (специалистов) участие в формировании существенных финансовых и административных условий.',
        'Идейные соображения высшего порядка, а также постоянный количественный рост и сфера нашей активности представляет собой интересный эксперимент проверки дальнейших направлений развития. Не следует, однако забывать, что сложившаяся структура организации обеспечивает широкому кругу (специалистов) участие в формировании существенных финансовых и административных условий. '
      ],
    } = options;

  .text-cut(data-text-cut)&attributes(attributes)
    .text-cut__wrapper(data-text-cut-wrapper)
      .text-cut__text.is-clamp(data-text-cut-text id=id)
        each p in text
          p!= p
    +button({
      text: 'Подробнее',
      ariaExpanded: "false",
      ariaControls: id,
      iconRight: 'icon-dropdown'
    }).text-cut__button(data-text-cut-button)
