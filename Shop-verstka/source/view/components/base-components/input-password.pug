mixin input-password(options = {})
	-
		const {
			id = Math.random().toString(36).substring(2),
			name = Math.random().toString(36).substring(2),
			disabled = false,
		} = options;

	.input-password(data-input-password)&attributes(attributes)
		+input({...options, type: "password"}).input-password__input
		+button({
			ariaLabel: 'Показать пароль',
			disabled: disabled,
			text: null,   
		}).input-password__visibility
