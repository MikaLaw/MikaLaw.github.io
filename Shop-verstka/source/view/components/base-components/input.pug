mixin input(options = {})
	-
		const {
			id = Math.random().toString(36).substring(2),
			name = Math.random().toString(36).substring(2),
			mask = false,
			value = false,
			required = false,
			placeholder = false,
			pattern = false,
			disabled = false,
			readonly = false,
			type = "text",
			autocomplete = false,
			autocompleted = false,
			min = false,
			max = false,
			inputmode = false,
			checked = false,
			minLength = false,
			maxLength = false,
			multiple = false,
			accept = false,
			spellcheck = false,
			role = false,
			enterkeyhint = false,
			ariaLabel = false,
			ariaLabelBy = false,
			ariaDescribedby = false,
			ariaErrormessage = false,
			ariaInvalid = false,
			ariaRequired = false,
			ariaDisabled = false,
			ariaAutocomplete = false,
			ariaControls = false,
			ariaExpanded = false,
			itemprop = false,
		} = options;

	input.input.input--base(
		data-maska=mask,
		id=id,
		name=name,
		type=type,
		value=value,
		required=required,
		placeholder=placeholder,
		pattern=pattern,
		disabled=disabled,
		readonly=readonly,
		role=role,
		autocomplete=autocomplete,
		autocompleted=autocompleted,
		min=min,
		max=max,
		enterkeyhint=enterkeyhint,
		inputmode=inputmode,
		checked=checked,
		minlength=minLength,
		maxlength=maxLength,
		multiple=multiple,
		accept=accept,
		spellcheck=spellcheck,
		aria-label=ariaLabel,
		aria-labelledby=ariaLabelBy,
		aria-describedby=ariaDescribedby,
		aria-errormessage=ariaErrormessage,
		aria-invalid=ariaInvalid,
		aria-required=ariaRequired,
		aria-disabled=ariaDisabled,
		aria-autocomplete=ariaAutocomplete,
		aria-controls=ariaControls,
		aria-expanded=ariaExpanded
		itemprop=itemprop
	)&attributes(attributes)
