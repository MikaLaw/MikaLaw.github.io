extends ../components/base/layout

block variables
	- const title = "Восстановление пароля" //- на страницах кроме главной используйте О нас — ProjectName
	- const wrapperMods = ""
	- const hasHeader = true
	- const headerMods = ""
	- const hasFooter = true
	- const hasFooterPanel = true 
	- const footerMods = ""
	- const currentUrl = "" //- для остальных страниц пишем пустую строку или индекс активного headerLinks

block main
	main.page__main
		+breadcrumbs({
			list: [{title: 'Главная', href: './main.html'}, {title: 'Восстановление пароля'}],
		})
		section.section
			.container
				.section__head
					h1.section__title Восстановление пароля
				.section__content
					.section__form
						.form-block(data-form data-validate-on-input data-validate-on-change data-validate-on-blur)
							form.form
								.form__wrapper
									.form__body 
										+field({
											fieldLabel: 'Введите Email',
											text: 'На указанную почту придёт ссылка для смены пароля',
											componentData: {
												required: true,
												type: 'email',
												name: 'email',
												autocomplete: "email",
												ariaDescribedby: "email-hint"
											},
										})
									.form__footer 
										+button({
											text: "Отправить запрос",
											type: 'submit',
											ariaLabel: "Отправить данные на сервер",
											iconRight: 'icon-arrow-right',
										}).button--base(data-form-submit)