extends ../components/base/layout

block variables
	- const title = "Регистрация" //- на страницах кроме главной используйте О нас — ProjectName
	- const wrapperMods = ""
	- const hasHeader = true
	- const headerMods = ""
	- const hasFooter = true
	- const hasFooterPanel = true 
	- const footerMods = ""
	- const currentUrl = "" //- для остальных страниц пишем пустую строку или индекс активного headerLinks

block main
	main.page__main
		+breadcrumbs({
			list: [{title: 'Главная', href: './main.html'}, {title: 'Регистрация'}],
		})
		section.section
			.container
				.section__head
					h1.section__title Регистрация
				.section__content
					+tabs({
						optionList: [
							{
								title: 'Розница',
								component: 'registration-panel-1'
							},
							{
								title: 'Салонам и мастерам',
								component: 'registration-panel-2'
							},
						]
					})