extends ../components/base/layout

block variables
	- const title = "Частые вопросы" //- на страницах кроме главной используйте О нас — ProjectName
	- const wrapperMods = ""
	- const hasHeader = true
	- const headerMods = ""
	- const hasFooter = true
	- const hasFooterPanel = true 
	- const footerMods = ""
	- const currentUrl = "" //- для остальных страниц пишем пустую строку или индекс активного headerLinks

block main
	main.page__main
		+breadcrumbs({
			list: [{title: 'Главная', href: './main.html'}, {title: 'Частые вопросы'}],
		})
		section.section
			.container
				.section__head
					h1.section__title Частые вопросы
				.section__content
					.faq
						.faq__section
							+accordion({
								optionList: accordionsOptionsList2,
							})
						.faq__section
							.small-form.small-form--faq(data-form data-validate-on-input data-validate-on-change)
								form.small-form__form
									.small-form__status.visually-hidden(role="status" aria-live="polite" data-form-status)
									.small-form__header
										h2.small-form__title Задать вопрос
									.small-form__body
										+field({
											componentData: {
												required: true,
												type: 'email',
												placeholder: '* Ваша почта',
												ariaLabel: 'Введите вашу почту',
												ariaDescribedby: "email-hint"      
											}
										})
										+field({
											component: 'textarea',
											componentData: {
												required: true,
												placeholder: '* Ваш вопрос',
												ariaLabel: 'Введите ваш вопрос',
												ariaDescribedby: "answer-hint" 
											}
										})
									.small-form__footer
										+button({
											text: "Отправить",
											type: 'submit',
											iconRight: 'icon-arrow-right'
										}).button--base(data-form-submit)
										.small-form__subtext Нажимая на кнопку «Отправить», я даю свое <a href="#" class="small-form__link">Согласие на обработку персональных данных</a>
