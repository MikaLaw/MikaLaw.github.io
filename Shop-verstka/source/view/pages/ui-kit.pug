
extends ../components/base/layout

block variables
	- const title = "Ui - kit"

block main
	style.
		.page {
			display: flex;
			flex-direction: column;
			flex: 1;
		}
		.page__head {
			padding: 40px 30px 80px;
			border-bottom: 4px solid #E3292C;
		}

		.page__menu{
			margin: 0;
			padding: 0
		}

		.page__body {
			flex: 1;
			padding: 40px 30px 80px;
			font-family: "Montserrat", "Arial", sans-serif;
		}

		h1 {
			text-align: center;
			font-size: 30px;
			line-height: 28px;
			font-weight: 800;
			margin-block-end: 50px;
		}

		ol ul {
			padding-inline-start: 20px;
		}

		ul {
			list-style: disc;
		}

		li {
			font-weight: 500;
		}

		a {
			font-weight: 400;
			color: #2c39f2;
			font-size: 16px;
			line-height: 26px;
		}

		.uikit__component{
			margin-block-end: 20px;
		}

		.uikit__component--width-1 {
			max-inline-size: 640px;
			width: 100%;
		}

		.uikit__flex {
			display: flex;		
			align-items: center;
			gap: 10px;
		}

		.uikit__flex-wrap {
			display: flex;		
			align-items: center;
			gap: 10px;
			flex-wrap: wrap;
		}

		.uikit__colors {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
			gap: 14px;
		}

		.uikit__color-wrapper {
			background: #FFFFFF;
			border: 1px solid #E8E5E2;
			border-radius: 4px;
		}

		.uikit__color {
			width: 100%;
			height: 100px;
			border-bottom: 1px solid #E8E5E2;
			border-radius: 4px;
		}

		.uikit__box {
			width: 100%;
			height: 100px;
			border: 1px solid #E8E5E2;
		}

		.uikit__margin {
			width: 50px;
			height: 25px;
			border: 1px solid #2a1f15;
			display: inline-flex;
			align-items: center;
			justify-content: center;
		}

		.uikit__color-title {
			padding: 10px;
		}

		.uikit__color-1 { background-color:  #f8f7f5}
		.uikit__color-2 { background-color:  #fcfcfc;}
