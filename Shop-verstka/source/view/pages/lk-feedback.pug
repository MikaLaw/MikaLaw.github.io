extends ../components/base/layout

block variables
	- const title = "ЛК-Обратная связь" //- на страницах кроме главной используйте О нас — ProjectName
	- const wrapperMods = ""
	- const hasHeader = true
	- const headerMods = ""
	- const hasFooter = true
	- const hasFooterPanel = true 
	- const footerMods = ""
	- const currentUrl = "" //- для остальных страниц пишем пустую строку или индекс активного headerLinks
	- const page = "./lk-feedback.html" //- обозначение страницы для проброса в панели подвала

block main
	main.page__main
		+breadcrumbs({
			list: [{title: 'Главная', href: './main.html'}, {title: 'Обратная связь'}],
		})
		section.section
			.container
				.section__wrapper 
					.section__sidebar
						+sidebar-menu({
							page: page,
						})
					.section__content
						+banner({
							title: 'Обратная связь',
							titleTag: 'h1',
							text: '<p>У вас возникли вопросы по вашему заказу, начислению или списанию бонусов, срокам доставки или вашей скидке?</p><p>Пожалуйста, свяжитесь с нами в удобном вам формате!</p>',
							img: './img/components/feedback-banner/img-1',
						})
							.banner__actions 
								a(href="#" target='_blank' rel='nofollow noopener noreferrer').button.button--outline
