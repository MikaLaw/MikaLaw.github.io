extends ../components/base/layout

block variables
	- const title = "Новости" //- на страницах кроме главной используйте О нас — ProjectName
	- const wrapperMods = ""
	- const hasHeader = true
	- const headerMods = ""
	- const hasFooter = true
	- const hasFooterPanel = true 
	- const footerMods = ""
	- const currentUrl = "" //- для остальных страниц пишем пустую строку или индекс активного headerLinks

block main
	main.page__main
		+breadcrumbs()
		section.section
			.container
				.section__head
					h1.section__title Новости
				.section__content
					.articles
						.articles__tags
							+section-tags({
								list: ['Все', 'О компании', 'Товары', 'Фотоотчеты', 'Мероприятия'] 
							})
						+list({
							list: articlesList,
							component: 'article-card',
							componentData: { titleTag: 'h2' },
						}).articles__list
						+list-controls({
							btnAriaLabel: 'Показать ещё следующие 10 новостей',
						}).articles__controls
		section.section
			.container
				.section__content
					+slider({
						name: 'card',
						title: '<h2  class="section__title"><a href="#" class="section__title-link">Вы смотрели <i class="icon icon-arrow-right"></i></a></h2>',
						optionList: productList1,
					}).slider--product
		section.section
			.container
				.section__head
					h2.section__title Место под seo-текст
				.section__content
					+text-cut()