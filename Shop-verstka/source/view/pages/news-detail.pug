extends ../components/base/layout

block variables
	- const title = "Новость детально" //- на страницах кроме главной используйте О нас — ProjectName
	- const wrapperMods = ""
	- const hasHeader = true
	- const headerMods = ""
	- const hasFooter = true
	- const hasFooterPanel = true 
	- const footerMods = ""
	- const currentUrl = "" //- для остальных страниц пишем пустую строку или индекс активного headerLinks

block main
	main.page__main
		+breadcrumbs({
			list: [{title: 'Главная', href: './main.html'}, {title: 'Новости', href: './news.html'}, {title: 'Всемирный день красоты в «модерн»!'}],
		})
		section.section
			.container
				.section__head
					h2.section__title Всемирный день красоты в «модерн»!
				.section__content
					.article.article--sidebar
						.article__tags
							+section-tags({
								list: ['Все', 'О компании', 'Фотоотчеты', 'Мероприятия'] 
							})
						.article__content
							.article__block
								.article__info
									.article__tag О КОМПАНИИ
									time.article__date(datetime="2022-05-28") 28 мая 2022
									.article__viewed
										i.icon.icon-eye 
										| 200 просмотров
