extends ../components/base/layout

block variables
	- const title = "Продавать с Модерн" //- на страницах кроме главной используйте О нас — ProjectName
	- const wrapperMods = ""
	- const hasHeader = true
	- const headerMods = ""
	- const hasFooter = true
	- const hasFooterPanel = true 
	- const footerMods = ""
	- const currentUrl = "" //- для остальных страниц пишем пустую строку или индекс активного headerLinks

block main
	main.page__main
		+breadcrumbs({
			list: [{title: 'Главная', href: './main.html'}, {title: 'Продавать с Модерн'}],
		})
		section.section
			.container
				.section__head
					h1.section__title Продавать с Модерн
				.section__content
					.advantages
						h2.advantages__title Почему продавать с Модерн — это выгодно?
						ul.advantages__list 
							each item in advantagesList1
								li.advantages__item 
									+advantages-card(item) 
		section.section
			.container
				.small-form.small-form--services(data-form data-validate-on-input data-validate-on-change)
					form.small-form__form
						.small-form__status.visually-hidden(role="status" aria-live="polite" data-form-status)
						.small-form__header
							h2.small-form__title Хотите узнать больше о нашем предложении?
						.small-form__body
							+field({
								validationType: "name",
								componentData: {
									required: true,
									pattern: "^[а-яёА-ЯЁa-zA-Z]+([ \\-][а-яёА-ЯЁa-zA-Z]+)+$",
									autocomplete: 'name',
									placeholder: '* Ваше ФИО',
									ariaLabel: 'Ведите ваше ФИО',
									ariaDescribedby: "fio-hint"
								}
							})
							+field({
								componentData: {
									required: true,
									type: 'email',
									placeholder: '* Ваша почта',
									ariaLabel: 'Ведите вашу почту',
									ariaDescribedby: "email-hint"      
								}
							})
							+field({				
								componentData: {
									required: true,
									mask: 'phone',
									name:"phone",
									type: "tel",
									autocomplete: "tel",
									placeholder: '* Ваш телефон',
									ariaLabel: 'Ведите ваш телефон',
									ariaDescribedby: "phone-hint"
								},
							})
							+field({
								component: 'textarea',
								componentData: {
									required: true,
									placeholder: '* Комментарий',
									ariaLabel: 'Ведите ваш комментарий',
									ariaDescribedby: "comment-hint"
								}
							})
						.small-form__footer
							+button({
								text: "Отправить",
								type: 'submit',
								ariaLabel: "Отправить данные на сервер",
								iconRight: 'icon-arrow-right'
							}).button--base(data-form-submit)
							.small-form__subtext Нажимая на кнопку «Отправить», я даю свое <a href="#" class="small-form__link">Согласие на обработку персональных данных</a>
		section.section
			.container
				.section__head
					h2.section__title Мы — официальные дистрибьюторы
				.section__content
					+distributors()