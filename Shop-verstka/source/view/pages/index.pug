
extends ../components/base/layout

block variables
  - const title = "Ui - kit"

block main
  style.
    .page {
      display: flex;
      flex-direction: column;
      flex: 1;
      overflow: hidden
    }
    .page__head {
      padding: 30px 30px 40px;
      border-bottom: 4px solid #E3292C;
    }

    .page__body {
      padding: 40px 30px 80px;
      flex: 1
    }

    h1 {
      text-align: center;
      font-size: 30px;
      line-height: 28px;
      font-weight: 800;
      margin-block-end: 50px;
    }

    a:hover {
      text-decoration: none;
    }

    ul {
      padding-inline-start: 20px;
    }

    .page__footer {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 30px 30px 40px;
      border-top: 4px solid #E3292C;
      border-bottom: 4px solid #E3292C;
      text-align: center;
    }

    .page__date {
      font-size: 18px; 
    }

    .uikit__component{
      margin-block-end: 20px;
    }

    .uikit__cell {
      width: 100%;
    }

    @media (min-inline-size: 768px) {
      .uikit__cell {
        max-inline-size: 50%;
      }
    }

    .menu {
      list-style: disc;
      width: fit-content;
      margin: 0 auto;
    }

