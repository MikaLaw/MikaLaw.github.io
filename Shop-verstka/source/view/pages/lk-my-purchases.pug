extends ../components/base/layout

block variables
	- const title = "ЛК-Мои покупки" //- на страницах кроме главной используйте О нас — ProjectName
	- const wrapperMods = ""
	- const hasHeader = true
	- const headerMods = ""
	- const hasFooter = true
	- const hasFooterPanel = true 
	- const footerMods = ""
	- const currentUrl = "" //- для остальных страниц пишем пустую строку или индекс активного headerLinks
	- const page = "./lk-my-purchases.html" //- обозначение страницы для проброса в панели подвала

block main
	main.page__main
		+breadcrumbs({
			list: [{title: 'Главная', href: './main.html'}, {title: 'Мои покупки'}],
		})
		section.section
			.container
				.section__wrapper 
					.section__sidebar
						+sidebar-menu({
							page: page,
						})
					.section__content
						.section__head
							h1.section__title Мои покупки
						.purchases
							.purchases__filters.purchases-filters
								form.purchases-filters__form
									.purchases-filters__field
										+input({
											placeholder: 'Номер заказа',
											ariaLabel: 'Введите номер заказа'
										})
									.purchases-filters__field
										+select({
											placeholder: 'Статус заказа',
											optionsList: [
												{label: 'Принят', value: '1'},
												{label: 'В сборке', value: '2'},
												{label: 'Оплачен', value: '3'},
												{label: 'Готов к отправке', value: '4'},
												{label: 'В пути', value: '5'},
												{label: 'Доставлен', value: '6'},
											],
										})
									.purchases-filters__field
										.purchases-filters__row 
											.purchases-filters__cell
												+field({
													component: 'input-datapicker',
													componentData: {
														placeholder: 'От',
														ariaLabel: 'Введите начало периода'
													}
												})
											.purchases-filters__cell-separator —
											.purchases-filters__cell
												+field({
													component: 'input-datapicker',
													componentData: {
														placeholder: 'До',
														ariaLabel: 'Введите конец периода'
													}
												})
									.purchases-filters__field
										+button({
											text: 'Искать',
											type: 'submit'
										}).button--base
							.purchases__list
								each item in purchasList
									.purchases__item
										+purchases-card(item)
							+list-controls().purchases__controls


