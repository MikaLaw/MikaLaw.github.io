extends ../components/base/layout

block variables
	- const title = "ЛК-Лист ожидания" //- на страницах кроме главной используйте О нас — ProjectName
	- const wrapperMods = ""
	- const hasHeader = true
	- const headerMods = ""
	- const hasFooter = true
	- const hasFooterPanel = true 
	- const footerMods = ""
	- const currentUrl = "" //- для остальных страниц пишем пустую строку или индекс активного headerLinks
	- const page = "./lk-waiting-list.html" //- обозначение страницы для проброса в панели подвала

block main
	main.page__main
		+breadcrumbs({
			list: [{title: 'Главная', href: './main.html'}, {title: 'Лист ожидания'}],
		})
		section.section
			.container
				.section__wrapper 
					.section__sidebar
						+sidebar-menu({
							page: page,
						})
					.section__content
						.section__head
							h1.section__title Лист ожидания
							+button({
								text: 'Очистить',
								ariaLabel: 'Удалить все товары из избранного'
							}).button--base
						ul.waiting-list
							each item in waitingList
								li.waiting-item 
									article.product-row.product-row--waiting-list
										.product-row__wrapper 
											.product-row__img-wrapper
												a.product-row__img(href="./product.html")
													+picture({
														format: "jpg",
														path: item.img,
														alt: "Товар",
														isLazyLoading: "lazy",
														isDecoding: "async",
														width: "320",
														height: "310",
														desktopSource: item.img,
														mobileSource: `${item.img}-mobile`,
													})
												if item.labels
													+product-stickers({list: item.labels, ariaLabel: "Метки товара"}).product-row__stickers
											.product-row__content-wrapper
												.product-row__info-wrapper
													h2.product-row__title
														a.product-row__link(href="./product.html")!= item.title
													.product-row__description!= item.text
													.product-row__subtext!= item.subtext
												.product-row__status(class= item.statusClass ? `product-row__status--${item.statusClass}` : '')!= item.status
											.product-row__control-wrapper
												if item.cost
													.product-row__price-wrapper
														.product-row__price-actual
															span.visually-hidden Текущая цена:
															!= item.cost
														if item.stock
															.product-row__price-old
																span.visually-hidden Старая цена:
																s!= item.stock
												+button({
													iconLeft: 'icon-cart',
													text: 'В корзину',
													ariaLabel: 'Добавить в корзину',
												}).button--base.button--icon(data-toast-notification-show="toast-cart-add-template")
												+button({
													iconLeft: 'icon-favorite',
													text: null,
													ariaLabel: 'Добавить в избранное',
													ariaPressed: "false"
												}).button--icon.button--icon-transparent.product-row__favorite(data-toast-notification-show="toast-cart-add-template")