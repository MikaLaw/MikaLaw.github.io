extends ../components/base/layout

block variables
	- const title = "Восстановление пароля" //- на страницах кроме главной используйте О нас — ProjectName
	- const wrapperMods = ""
	- const hasHeader = true
	- const headerMods = ""
	- const hasFooter = true
	- const hasFooterPanel = true 
	- const footerMods = ""
	- const currentUrl = "" //- для остальных страниц пишем пустую строку или индекс активного headerLinks

block main
	main.page__main
		+breadcrumbs({
			list: [{title: 'Главная', href: './main.html'}, {title: 'Восстановление пароля'}],
		})
		section.section
			.container
				.section__head
					h1.section__title Восстановление пароля
				.section__content
					.section__form
						.form-block(data-form data-validate-on-input data-validate-on-change data-validate-on-blur)
							form.form
								.form__wrapper
									.form__body 
										+field({
											fieldLabel: 'Новый пароль',
											component: 'input-password',
											componentData: {
												required: true,
												autocomplete: "new-password",
												spellcheck: 'false',
												ariaDescribedby: 'new-pass-1'
											},
											validationType: "match",
											matchName: 'password'
										})
										+field({
											fieldLabel: 'Повторите новый пароль',
											component: 'input-password',
												componentData: {
													required: true,
													autocomplete: "new-password",
													spellcheck: 'false',
													ariaDescribedby: 'new-pass-2',													
											},
											validationType: "match",
											matchName: 'password'
										})
									.form__footer 
										+button({
											text: "Сохранить",
											type: 'submit',
											ariaLabel: "Отправить данные на сервер",
										}).button--base(data-form-submit)